{
  "name": "Zinsight",
  "productName": "Zinsight",
  "version": "1.4.2",
  "description": "轻量级个人记账应用（桌面端 Electron + 安卓端 Capacitor）",
  "license": "MIT",
  "author": {
    "name": "zhoujin",
    "email": "zhoujin@users.noreply.github.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:www": "node scripts/build-www.js",
    "lint": "node scripts/check-style.js",
    "test:core": "npm run lint && node scripts/test-core.js && node scripts/test-ai.js",
    "android:init": "npm run build:www && npx cap add android && node scripts/android-version.js && node scripts/android-icons.js",
    "android:sync": "npm run build:www && node scripts/android-version.js && node scripts/android-icons.js && npx cap sync android",
    "android:icons": "node scripts/android-icons.js",
    "android:version": "node scripts/android-version.js",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "npx cap open android"
  },
  "build": {
    "appId": "com.zinsight.app",
    "productName": "Zinsight",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bug010101",
        "repo": "Zinsight"
      }
    ],
    "files": [
      "main.js",
      "src/**/*",
      "assets/desktop/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "assets/desktop/dock-icon.png",
      "target": [
        "dmg",
        "dir"
      ],
      "identity": null
    },
    "win": {
      "icon": "assets/desktop/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/desktop/dock-icon.png",
      "target": [
        "deb"
      ],
      "category": "Utility",
      "maintainer": "zhoujin <zhoujin@users.noreply.github.com>"
    },
    "dmg": {
      "title": "Zinsight ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  }
}
